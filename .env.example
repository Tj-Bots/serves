# סוד לחתימת cookies של session - חובה לשנות בפרודקשן!
SECRET_KEY=change-me-to-a-long-random-string

# כתובת מסד הנתונים
DATABASE_URL=sqlite:////var/serves/db/serves.db

# תיקיות עבודה בדיסק
APPS_DIR=/var/serves/apps
LOGS_DIR=/var/serves/logs

# מגבלות תוכנית חינמית (גם ברירת המחדל לתוכניות בתשלום, ראו PRO_*/PLUS_* למטה)
FREE_MAX_APPS=1
FREE_MEMORY_MB=256
FREE_CPU_CORES=0.5
FREE_DISK_MB=2048
FREE_BANDWIDTH_MBPS=5
# אחרי כמה ימים מההרשמה תוכנית חינמית מפסיקה לעבוד (אפליקציות נעצרות
# אוטומטית ולא ניתן ליצור/להפעיל עד שדרוג). 0 = בלי הגבלת זמן.
FREE_TRIAL_DAYS=14

# מגבלת גודל קובץ zip שמותר להעלות כמקור קוד (חלופה לריפו git)
MAX_ZIP_UPLOAD_MB=200

# רשת Docker מבודדת לאפליקציות (subnet קבוע כדי ש-iptables יוכל לחסום מולו)
SANDBOX_NETWORK=serves_sandbox
SANDBOX_SUBNET=172.30.0.0/24
BASE_IMAGE=serves-python-base:3.11

# חייב להתאים בדיוק ל-uid/gid של botuser ב-docker/base.Dockerfile
SANDBOX_UID=1000
SANDBOX_GID=1000

# הגבלת רוחב פס פר-אפליקציה עם tc/ifb ברמת המארח (ראו app/services/bandwidth.py) -
# דורש root ומודול ליבה ifb זמין. best-effort: אם זה נכשל בשרת שלכם, אפשר
# לכבות לגמרי בלי להשפיע על שאר הפלטפורמה.
BANDWIDTH_LIMIT_ENABLED=true

# פורט שמור שמוזרק לכל אפליקציה - אם למשתמש יש שרת אינטרנט, שיאזין כאן
APP_PORT=8080

# פורט האתר (backend, מאחורי ה-nginx אם יש)
PORT=8000

# הגבלות קצב בסיסיות נגד ניצול לרעה (בזיכרון, לא Redis)
SIGNUP_IP_MAX_PER_DAY=3
DEPLOY_ACTION_MAX=5
DEPLOY_ACTION_WINDOW_SECONDS=60

# הגדרות SMTP לשליחת מייל אימות (קוד בן 6 ספרות) בהרשמה.
# אם SMTP_HOST ריק - הקוד רק יודפס ללוגים של השרת (journalctl -u serves)
# ולא יישלח בפועל. לדוגמה עם Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<App Password, לא הסיסמא הרגילה>
# אם 587+STARTTLS לא עובד (חסום ע"י הספק) נסו 465+SSL במקום:
# SMTP_PORT=465, SMTP_USE_SSL=true, SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TeleBoss <no-reply@boss-server-bot.online>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# אם SMTP עוד לא מוגדר/עובד ורוצים לבדוק את שאר האתר בלי אימות מייל,
# אפשר להגדיר REQUIRE_EMAIL_VERIFICATION=false זמנית (כל משתמש חדש
# ייחשב מאומת אוטומטית, וגם משתמשים קיימים לא-מאומתים יעברו את הבדיקה).
# חשוב להחזיר ל-true כשה-SMTP עובד.
REQUIRE_EMAIL_VERIFICATION=true

# תוכניות בתשלום (כוכבי טלגרם) - השאירו PAYMENT_BOT_TOKEN ריק כדי להשבית שדרוגים.
# PRO/PLUS יורשים ברירת מחדל את משאבי FREE_* (זיכרון/CPU/דיסק) - הגדירו
# PRO_MEMORY_MB / PRO_CPU_CORES / PRO_DISK_MB (וכנ"ל PLUS_*) רק אם רוצים
# ערך שונה מהתוכנית החינמית עבור תוכנית ספציפית.
PRO_MAX_APPS=3
PRO_PLAN_STARS=1000

PLUS_MAX_APPS=5
PLUS_PLAN_STARS=2500
PLUS_MEMORY_MB=1024
PLUS_CPU_CORES=1.0
PLUS_DISK_MB=8192
PLUS_BANDWIDTH_MBPS=100
# PRO_BANDWIDTH_MBPS - ברירת המחדל אם לא מוגדר: פי 3 מ-FREE_BANDWIDTH_MBPS

PAYMENT_BOT_TOKEN=
PAYMENT_BOT_USERNAME=
PAYMENT_LINK_TTL_MINUTES=30

# כתובת הבסיס הציבורית של האתר (לקישור "פתח דשבורד" בהודעת אישור תשלום)
PUBLIC_BASE_URL=https://teleboss.online

# פאנל ניהול באתר - נתיב סודי (לא מקושר משום מקום באתר) + התחברות נפרדת
# משלו (לא קשור לחשבונות משתמשים). אם ADMIN_USERNAME/ADMIN_PASSWORD ריקים
# הפאנל כבוי לגמרי (404). שנו את שלושתם לערכים משלכם לפני הפעלה!
ADMIN_PATH=admin997799
ADMIN_USERNAME=
ADMIN_PASSWORD=

# מזהי טלגרם (מספריים, לא username - אפשר לקבל מ-@userinfobot) שמורשים
# בפקודת /admin בבוט התשלומים. כמה מזהים מופרדים בפסיק.
ADMIN_TELEGRAM_IDS=
