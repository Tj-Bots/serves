# תבנית קונפיגורציית nginx ל-reverse proxy מול הפלטפורמה.
# install.sh מחליף את __DOMAIN__ ומעתיק את הקובץ ל-/etc/nginx/sites-available/serves
# לאחר מכן מריצים: certbot --nginx -d __DOMAIN__   כדי לקבל HTTPS.
#
# server_name כולל גם *.__DOMAIN__ (סאב-דומיין לכל אפליקציה, למשל
# my-bot.__DOMAIN__) - זה לא עושה כלום עד שמוסיפים בפועל רשומת DNS
# wildcard ותעודת SSL wildcard, ראו README.md בסעיף "סאב-דומיין לכל אפליקציה".

server {
    listen 80;
    server_name __DOMAIN__ *.__DOMAIN__;

    # תואם ל-MAX_ZIP_UPLOAD_MB (ברירת מחדל 200MB, ראו .env.example) - עם
    # שוליים קטנים, כדי שהעלאת zip כמקור קוד לא תיחסם ע"י nginx לפני
    # שהיא בכלל מגיעה לבדיקת הגודל של האפליקציה עצמה.
    client_max_body_size 220m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
